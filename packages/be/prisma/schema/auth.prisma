model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  username  String    @unique
  status    String    @default("active")
  authType  String    @default("internal")
  roles     String?
  password  String?
  firstname String?
  lastname  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
