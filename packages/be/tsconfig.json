{
  "compilerOptions": {
    "target": "es2016",
    "lib": [
      "es2022"
    ],
    "module": "commonjs",
    "rootDir": "src",
    "typeRoots": [
      "./types"
    ],
    "outDir": "build/js",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
