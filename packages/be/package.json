{
  "name": "patchwork2-server",
  "version": "1.0.0",
  "main": "src/app.ts",
  "license": "MIT",
  "private": true,
  "prisma": {
    "seed": "ts-node prisma/seed"
  },
  "scripts": {
    "build": "tsc",
    "prisma-generate-client": "prisma generate",
    "prisma-migrate-dev": "prisma migrate dev",
    "prisma-migrate-baseline": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema --script > prisma/migrations/0_initial/migration.sql",
    "prisma-migrate-reset": "prisma migrate reset",
    "start-dev": "ts-node $npm_package_main | npx pino-pretty"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@prisma/adapter-libsql": "^6.0.0",
    "@prisma/client": "6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.1",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
